# syntax=docker/dockerfile:1.7
# vim: ft=dockerfile
#
# datawatch agent-aider — aider-chat only.
# Heavy due to litellm's 100+ deps; ~1.2GB irreducibly.
# pipx isolates aider's deps from the system Python (PEP 668).

ARG REGISTRY=localhost:5000/datawatch
ARG BASE_TAG=latest
ARG AIDER_VERSION=0.86.0

FROM ${REGISTRY}/agent-base:${BASE_TAG} AS runtime
ARG AIDER_VERSION

USER root
# Full python (not just minimal) is needed for many of aider's deps.
# build-essential lets pip compile native wheels when prebuilt aren't avail.
RUN install_packages \
        python3 python3-pip python3-venv pipx \
        build-essential pkg-config libffi-dev libssl-dev && \
    PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install aider-chat==${AIDER_VERSION} && \
    # Upgrade vulnerable transitive deps within aider's venv to their patched versions.
    # Aider pins these conservatively; force minimums that clear all Trivy HIGH/CRITICAL.
    # Use python -m pip (not the pip symlink) — Debian venvs omit the bare pip binary.
    /opt/pipx/venvs/aider-chat/bin/python -m pip install --quiet --no-cache-dir \
        "gitpython>=3.1.50" \
        "litellm>=1.83.7" \
        "urllib3>=2.7.0" \
        "pyasn1>=0.6.3" \
        "pillow>=12.2.0" && \
    # linux-libc-dev (kernel headers) is pulled by build-essential for C compilation
    # of Python native extensions during pip install. All compilation is now done;
    # purge it to eliminate 100+ unfixable kernel CVEs from the Trivy scan.
    # --force-depends avoids cascade-removing libc6-dev/build-essential which
    # are no longer needed but which apt's dependency solver would drag along.
    dpkg -r --force-depends linux-libc-dev && \
    # Aggressive cleanup — pipx leaves install artifacts and pip caches
    rm -rf /root/.cache/pip /opt/pipx/.cache /home/datawatch/.cache \
           /var/cache/apt/* \
           /usr/share/doc /usr/share/man /usr/include \
           /tmp/* /root/.npm

USER datawatch

LABEL datawatch.variant="agent-aider" \
      datawatch.agent="aider-chat" \
      datawatch.tools.aider=$AIDER_VERSION
