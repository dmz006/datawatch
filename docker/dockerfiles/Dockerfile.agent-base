# syntax=docker/dockerfile:1.7
# vim: ft=dockerfile
#
# datawatch agent-base — minimal foundation. ONLY contains the things
# every agent and every language image needs:
#   * datawatch binary
#   * tmux + git + gh + ssh + ca-certs + tini
#   * unix tooling claude shells out to (ripgrep, jq, fd, less, ...)
#
# Does NOT contain:
#   * any LLM agent (claude, opencode, aider, gemini) — those live in agent-* images
#   * any language toolchain (Go/Node/Python/Rust/Kotlin) — those live in lang-* images
#   * Node.js or Python — only in the agent/lang images that need them
#   * /usr/include, /usr/share/{doc,man,locale,info} — stripped after install
#
# Composition model: deploy one agent-* image and one lang-* image as
# two containers in the same Pod (or docker-compose service group),
# sharing /workspace as a volume. The K8s driver in F10 sprint 4 will
# auto-build the manifest from a Project Profile's {agent, language}
# tuple.
#
# Target size: ~250-300MB.

ARG GO_VERSION=1.26.9
ARG MINIDEB_TAG=bookworm
ARG RTK_VERSION=0.37.0
# GitHub CLI, built from source in the ghbuilder stage (see Layer 2 below
# for why). GH_VERSION must be a RELEASED cli/cli tag, never trunk;
# GH_COMMIT is that tag's commit and is checked after the clone.
# GH_GO_VERSION is the builder toolchain. Confirm the exact
# golang:<ver>-bookworm tag exists (docker buildx imagetools inspect)
# before changing it, because a missing tag silently resolving to an
# older Go is how this kind of drift slips through. GH_XNET_VERSION is
# the golang.org/x/net forced into gh's module graph.
ARG GH_VERSION=2.102.0
ARG GH_COMMIT=fc4b137cdef0a6bd28fd461b7cf9c84a5812a8cd
ARG GH_GO_VERSION=1.27.2
ARG GH_XNET_VERSION=0.60.0

# ── Stage 1: Go builder for the datawatch binary ────────────────────────
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-${MINIDEB_TAG} AS dwbuilder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
# Pin toolchain to the image's Go version — prevents GOTOOLCHAIN=auto from
# downloading a newer (potentially vulnerable) toolchain from go.dev at
# build time. Must stay >= go.mod's `go` directive or `go mod download`
# fails outright (found v9.0.0 release, 2026-10-09: go.mod had moved to
# 1.26.9 while this stayed pinned at 1.26.6). The exact patch pinned in
# GO_VERSION contains fixes for CVE-2026-42504 (net/textproto MIME header
# DoS), GO-2026-5856 (crypto/tls ECH privacy leak), and CVE-2026-39822
# (os.Root symlink follow) — later patches retain these fixes.
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
# Build the REAL embedded docs search index (internal/docsindex/embedded.go
# //go:embeds assets/docs-bm25-index.json, not the docs/ mirror directly).
#
# 2026-10-13 — found live running release-smoke.sh in external-daemon
# mode against a real deployed chart for the first time ever:
# docs_search/docs_list_howtos returned zero results. This line
# previously only stubbed a throwaway `{}` placeholder (to satisfy the
# go:embed directive so the build compiles) and never generated the
# real index — meaning EVERY production image built from this
# Dockerfile has always shipped with an empty docs corpus, not just
# the kind-smoke test daemon. `make docs-index` depends on `sync-docs`
# (plain rsync, not in the base golang image — installed below) to
# first populate internal/server/web/docs/ from docs/, then runs
# `go run ./cmd/docs-index-gen` to build the real index.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends rsync \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    make sync-docs docs-index
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
      -trimpath \
      -ldflags="-s -w -X main.Version=${VERSION}" \
      -o /out/datawatch \
      ./cmd/datawatch
# BL174 — also build the native Go MCP channel bridge so claude-mode
# sessions inside the container don't need a Node.js runtime. Lands as
# a sibling of /usr/local/bin/datawatch and is auto-detected at startup.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /out/datawatch-channel \
      ./cmd/datawatch-channel

# ── Stage 1b: GitHub CLI built from source (BL426) ──────────────────────
FROM --platform=$BUILDPLATFORM golang:${GH_GO_VERSION}-${MINIDEB_TAG} AS ghbuilder
ARG TARGETOS
ARG TARGETARCH
ARG GH_VERSION
ARG GH_COMMIT
ARG GH_GO_VERSION
ARG GH_XNET_VERSION
# Same rule as dwbuilder: never let gh's go.mod `toolchain` line pull a
# different Go from go.dev; the binary must be built by GH_GO_VERSION.
ENV GOTOOLCHAIN=local
RUN git clone --depth 1 --branch "v${GH_VERSION}" https://github.com/cli/cli.git /src/gh && \
    test "$(git -C /src/gh rev-parse HEAD)" = "${GH_COMMIT}"
WORKDIR /src/gh
RUN --mount=type=cache,target=/go/pkg/mod \
    go get "golang.org/x/net@v${GH_XNET_VERSION}" && \
    go mod tidy
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
      -trimpath \
      -ldflags="-s -w -X github.com/cli/cli/v2/internal/build.Version=${GH_VERSION}" \
      -o /out/gh \
      ./cmd/gh
# Fail the build if the binary doesn't carry the pinned Go and x/net.
RUN go version -m /out/gh > /out/gh.buildinfo && \
    cat /out/gh.buildinfo && \
    grep -qxF "/out/gh: go${GH_GO_VERSION}" /out/gh.buildinfo && \
    grep -qE "^[[:space:]]+dep[[:space:]]+golang\.org/x/net[[:space:]]+v${GH_XNET_VERSION}[[:space:]]" /out/gh.buildinfo

# ── Stage 2: runtime ────────────────────────────────────────────────────
FROM bitnami/minideb:${MINIDEB_TAG} AS runtime
ARG RTK_VERSION
ARG TARGETARCH

# Apt — every package an agent or language image will eventually depend on.
# bitnami's install_packages cleans /var/lib/apt/lists/ for us.
RUN install_packages \
        # process supervision
        tini \
        # session multiplexing
        tmux \
        # tls + dns
        ca-certificates openssl \
        # vcs
        git git-lfs openssh-client gnupg \
        # core unix
        bash coreutils findutils grep sed gawk less \
        # network
        curl wget rsync \
        # claude's heavy hitters
        ripgrep fd-find jq \
        # archives
        xz-utils zip unzip \
        # operator essentials only
        procps file tree which sudo && \
    # debian's fd-find binary is /usr/bin/fdfind; symlink to `fd` for
    # compatibility with claude-code's hardcoded `fd` invocations.
    ln -sf /usr/bin/fdfind /usr/local/bin/fd

# ── Layer 2: GitHub CLI (built from source in ghbuilder) ────────────────
# BL426, 2026-10-14: this used to be `install_packages gh` from the
# cli.github.com apt repo. Every Release run from v9.0.62 on failed
# "Scan agent-base - HIGH/CRITICAL" on 4 findings, all in Trivy Target
# usr/bin/gh (stdlib v1.27.1: CVE-2026-78667, CVE-2026-78669,
# CVE-2026-97031; golang.org/x/net v0.58.0: CVE-2026-78669). The
# datawatch binaries were clean. gh_2.102.0, the newest cli/cli release,
# ships built with go1.27.1 and x/net v0.58.0. cli/cli trunk has already
# moved to go1.27.2 and x/net v0.60.0, but no release includes them yet.
# So the released v2.102.0 source is rebuilt in the ghbuilder stage with
# GH_GO_VERSION and GH_XNET_VERSION. Evidence:
# docs/plans/2026-10-14-bl426-agent-base-trivy.md.
# Back to apt (or a pinned release .deb) once a cli/cli release ships with
# Go >= 1.27.2 and x/net >= v0.60.0. Check with `go version -m`.
COPY --from=ghbuilder /out/gh /usr/bin/gh

# ── Layer 2b: apply available security upgrades ─────────────────────────
# Pull in Debian bookworm security patches that postdate the base image
# build (fixes libc-bin CVE-2026-0861, libcap2 CVE-2026-4878,
# libsystemd0/libudev1 CVE-2026-29111, and any future bookworm patches).
# Separate layer so the upgrade isn't hidden inside install_packages.
RUN apt-get update -qq && \
    apt-get upgrade -y -q --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 3: rtk binary (token-saving CLI used by every agent) ─────────
RUN ARCH="$TARGETARCH"; case "$ARCH" in \
        amd64) RTK_ARCH="x86_64-unknown-linux-musl" ;; \
        arm64) RTK_ARCH="aarch64-unknown-linux-gnu" ;; \
        *) echo "unsupported arch $ARCH"; exit 1 ;; \
    esac && \
    curl -fsSL --retry 10 --retry-delay 30 --retry-all-errors \
        "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-${RTK_ARCH}.tar.gz" \
        -o /tmp/rtk.tar.gz && \
    tar -xzf /tmp/rtk.tar.gz -C /usr/local/bin/ rtk && \
    chmod +x /usr/local/bin/rtk && \
    rm /tmp/rtk.tar.gz

# ── Layer 4: aggressive size cleanup ────────────────────────────────────
# Strip everything an agent at runtime never reads:
#   * docs/man — operator can read on the host
#   * locales — keep only en_US (most agents are English)
#   * /usr/include — C headers belong in lang-* images, not here
#   * cache + tmp leftovers
#
# This pass alone removes ~200MB on agent-base and on every downstream
# variant that doesn't restore them.
RUN \
    # Wipe contents but KEEP the directory trees — apt post-install scripts
    # for some downstream packages (openjdk-17-* in particular) try to
    # write into /usr/share/man/manN. If the dir is gone, dpkg fails.
    find /usr/share/doc /usr/share/doc-base /usr/share/man /usr/share/info \
         /usr/share/groff /usr/share/lintian /usr/share/linda \
         /usr/share/python-wheels \
         -mindepth 1 -type f -delete 2>/dev/null || true && \
    # /usr/include is safe to delete — only language images need C headers
    rm -rf /usr/include /var/cache/apt/* /var/log/* /tmp/* /root/.cache && \
    # Keep only english locales — saves ~22MB
    find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
        ! -name 'en' ! -name 'en_US' ! -name 'en_US.UTF-8' \
        -exec rm -rf {} +

# ── Layer 5: non-root user, dirs, datawatch binary ──────────────────────
RUN groupadd -r -g 10001 datawatch && \
    useradd -r -u 10001 -g datawatch -m -d /home/datawatch -s /bin/bash datawatch && \
    mkdir -p /data /workspace && \
    chown -R datawatch:datawatch /data /workspace /home/datawatch

COPY --from=dwbuilder /out/datawatch /usr/local/bin/datawatch
# BL174 — sibling of datawatch so internal/channel.BinaryPath finds it
# without DATAWATCH_CHANNEL_BIN. Adds ~7-8 MB.
COPY --from=dwbuilder /out/datawatch-channel /usr/local/bin/datawatch-channel
COPY docker/entrypoint.sh /usr/local/bin/datawatch-entrypoint
RUN chmod +x /usr/local/bin/datawatch-entrypoint

USER datawatch
WORKDIR /data
ENV DATAWATCH_DATA_DIR=/data \
    DATAWATCH_WORKSPACE_ROOT=/workspace \
    PATH="/home/datawatch/.local/bin:${PATH}"

EXPOSE 8080 8443 8081

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/datawatch-entrypoint"]
CMD ["start", "--foreground"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["datawatch", "health"]

LABEL org.opencontainers.image.title="datawatch agent-base" \
      org.opencontainers.image.description="Minimal foundation — datawatch + tmux + git + gh + rtk + unix tooling. No agents, no language toolchains. Compose with one agent-* + one lang-* image per Pod." \
      org.opencontainers.image.source="https://github.com/dmz006/datawatch" \
      org.opencontainers.image.licenses="MIT" \
      datawatch.variant="agent-base" \
      datawatch.tools.rtk=$RTK_VERSION
