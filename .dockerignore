# Build artifacts
/dist/
/bin/
/build/
*.tar.xz
datawatch-linux-*
datawatch-darwin-*

# Editor / IDE
.idea/
.vscode/
*.swp
.DS_Store

# Local dev state
.env
.env.local
.env.build

# Tests + coverage
*.test
*.out
coverage.html

# Git (we don't need history inside the build context)
.git/
.gitignore

# CI / external tooling not needed at build time
.github/
charts/
README.md
CHANGELOG.md
LICENSE
# NOTE (2026-10-13): docs/ used to be excluded here too, which meant
# Dockerfile.agent-base's `make sync-docs docs-index` step (needed to
# populate internal/docsindex's REAL //go:embed search index, not
# just satisfy the embed directive with a stub) could never see
# docs/ at all -- rsync failed with "No such file or directory".
# Every production image built from this Dockerfile shipped with an
# empty docs_search/docs_list_howtos corpus until this was found live
# running release-smoke.sh against a real deployed chart. docs/ is
# ~22MB (negligible build-context cost) and is now required at build
# time -- do not re-add it here.

# Local datawatch runtime state if anyone ever drops it here
.datawatch/
sessions/
memory.db*
*.log

# Node/Python noise from sub-projects (channel.js dev deps, etc.)
node_modules/
__pycache__/
*.pyc

# datawatch-managed (BL219)
.aider.conf.yml
.aider.chat.history.md
.aider.tags.cache.v*/

# datawatch-managed (BL219)
.goose/

# datawatch-managed (BL219)
.gemini/
