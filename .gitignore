# E2E test runner lives outside the repo at ../datawatch-testing/
# Test artifacts (data dir, run evidence) stay there — not here.
# Only run summaries/failures are synced back here (gitignored).
docs/testing/runs/2*/

# Legacy: was inside repo, now outside. Keep ignored in case stale dir exists.
.datawatch-test/

# BL365 core + hostile-LLM security assessment — sandbox data dirs (throwaway
# daemon data dir, audit logs, .mcp.json with a throwaway admin token). The
# *harness* (scripts/sec-assess/) and the plan docs are committed; the
# sandboxes themselves are operator-local, contain token-ish files, and must
# not land in git (AGENT.md "No local-environment leaks" + Security Rules).
.sec-sandbox/
.hllm-sandbox/
.sec-sandbox-bin/
artifacts/

# test and tooling debris that escaped into the repo root (2026-10-17)
__pycache__/
*.pyc
/etc/
/ts706-upload.txt

# Runtime folders that live checks and the restart harness create; never commit them
/tmp-sandbox/
/rmt/
/.rm-run/

# Build and generated artifacts that tasks have committed by mistake
/datawatch-channel
/internal/server/web/assets/docs-bm25-index.json
.aider*

# sandbox live-check working dirs (daemon state, personas, session data) — never commit
tmp-held-verify/
tmp-sandbox/

# Operator's machine-specific leak patterns are never committed (see
# scripts/leak-patterns.local.template); the checked-in class definitions
# live in scripts/leak-check.patterns.
.leak-patterns.local

# Local list of pool names the supervisor watch skips (never committed).
.supervisor-watch-skip

# Gate run logs (test/lint output captured during final gates; never committed).
.gate-run/

# Daily plans tidy (scripts/plans-tidy-daily.sh) scratch and reports
.datawatch/scratch/
.datawatch/reports/

# pre-tag runner record (scripts/pre-tag.sh)
.datawatch/pre-tag-record
