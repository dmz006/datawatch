package tooling

import (
	"os"
	"os/exec"
	"path/filepath"
	"reflect"
	"testing"
)

// newGitRepoDir creates a small real git repository in a temp dir, with an
// optional set of files already committed (tracked) under the given
// basenames.
func newGitRepoDir(t *testing.T, tracked []string) string {
	t.Helper()
	git, err := exec.LookPath("git")
	if err != nil {
		t.Skipf("git not on PATH: %v", err)
	}
	dir := t.TempDir()
	run := func(args ...string) {
		t.Helper()
		if out, rerr := exec.Command(git, "-C", dir, args...).CombinedOutput(); rerr != nil {
			t.Fatalf("git %v: %v: %s", args, rerr, out)
		}
	}
	run("init", "-q")
	run("config", "user.email", "test@example.com")
	run("config", "user.name", "runner")
	_ = os.WriteFile(filepath.Join(dir, "keep.txt"), []byte("baseline\n"), 0o644)
	run("add", "--", "keep.txt")
	run("commit", "-q", "-m", "baseline")
	for _, name := range tracked {
		if err := os.WriteFile(filepath.Join(dir, name), []byte("tracked scratch\n"), 0o644); err != nil {
			t.Fatalf("write %s: %v", name, err)
		}
		run("add", "--", name)
	}
	if len(tracked) > 0 {
		run("commit", "-q", "-m", "commit scratch files")
	}
	return dir
}

func mustWrite(t *testing.T, path, content string) {
	t.Helper()
	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
		t.Fatalf("write %s: %v", path, err)
	}
}

func TestCleanupRunArtifactsRemovesUntrackedScratch(t *testing.T) {
	dir := newGitRepoDir(t, nil)
	mustWrite(t, filepath.Join(dir, ".decompose-output-abc123.json"), "{}")
	_ = os.MkdirAll(filepath.Join(dir, "nested"), 0o755)
	mustWrite(t, filepath.Join(dir, "nested", ".verify-output-4fe2a1.json"), "{}")
	mustWrite(t, filepath.Join(dir, "nested", "decompose-output.json"), "{}")
	mustWrite(t, filepath.Join(dir, "nested", "decompose-output.json.failed"), "{}")

	removed, leftover := CleanupRunArtifacts(dir)
	want := []string{
		"nested/decompose-output.json",
		"nested/decompose-output.json.failed",
		"nested/.verify-output-4fe2a1.json",
		".decompose-output-abc123.json",
	}
	if !reflect.DeepEqual(removed, want) {
		t.Errorf("removed = %v, want %v", removed, want)
	}
	if len(leftover) != 0 {
		t.Errorf("leftover = %v, want empty", leftover)
	}
	for _, rel := range want {
		if _, err := os.Stat(filepath.Join(dir, rel)); !os.IsNotExist(err) {
			t.Errorf("scratch file %s still present", rel)
		}
	}
}

func TestCleanupRunArtifactsKeepsTrackedScratch(t *testing.T) {
	dir := newGitRepoDir(t, []string{".decompose-output-abc123.json"})

	removed, leftover := CleanupRunArtifacts(dir)
	if len(removed) != 0 {
		t.Errorf("removed = %v, want empty (tracked file must not be deleted)", removed)
	}
	if _, err := os.Stat(filepath.Join(dir, ".decompose-output-abc123.json")); err != nil {
		t.Errorf("tracked scratch file was deleted: %v", err)
	}
	if !contains(leftover, ".decompose-output-abc123.json") {
		t.Errorf("leftover = %v, want it to contain %s", leftover, ".decompose-output-abc123.json")
	}
}

func TestCleanupRunArtifactsLeftoverUnknownFile(t *testing.T) {
	dir := newGitRepoDir(t, nil)
	mustWrite(t, filepath.Join(dir, "mystery.txt"), "unexpected\n")

	removed, leftover := CleanupRunArtifacts(dir)
	if len(removed) != 0 {
		t.Errorf("removed = %v, want empty", removed)
	}
	if !contains(leftover, "mystery.txt") {
		t.Errorf("leftover = %v, want it to contain mystery.txt", leftover)
	}
	if _, err := os.Stat(filepath.Join(dir, "mystery.txt")); err != nil {
		t.Errorf("mystery.txt was removed: %v", err)
	}
}

func TestCleanupRunArtifactsOutsideProjectUntouched(t *testing.T) {
	root := newGitRepoDir(t, nil)
	proj := filepath.Join(root, "project")
	if err := os.MkdirAll(proj, 0o755); err != nil {
		t.Fatal(err)
	}
	mustWrite(t, filepath.Join(proj, ".decompose-output-abc123.json"), "{}")
	outside := filepath.Join(root, ".verify-output-cafe01.json")
	mustWrite(t, outside, "{}")

	removed, leftover := CleanupRunArtifacts(proj)
	if !reflect.DeepEqual(removed, []string{".decompose-output-abc123.json"}) {
		t.Errorf("removed = %v, want the scratch file inside projectDir only", removed)
	}
	if len(leftover) != 0 {
		t.Errorf("leftover = %v, want empty", leftover)
	}
	if _, err := os.Stat(outside); err != nil {
		t.Errorf("scratch file outside projectDir was touched: %v", err)
	}
}

func TestCleanupRunArtifactsNoGitReportsInsteadOfDeleting(t *testing.T) {
	dir := t.TempDir() // not a git repository
	mustWrite(t, filepath.Join(dir, ".decompose-output-abc123.json"), "{}")

	removed, leftover := CleanupRunArtifacts(dir)
	if len(removed) != 0 {
		t.Errorf("removed = %v, want empty (no git → nothing deleted)", removed)
	}
	if _, err := os.Stat(filepath.Join(dir, ".decompose-output-abc123.json")); err != nil {
		t.Errorf("candidate was deleted without git confirmation: %v", err)
	}
	if !contains(leftover, ".decompose-output-abc123.json") {
		t.Errorf("leftover = %v, want it to report the candidate", leftover)
	}
}

func contains(list []string, want string) bool {
	for _, s := range list {
		if s == want {
			return true
		}
	}
	return false
}
